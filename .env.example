# =============================================================================
# 3D Quantum Note Universe — configuration
# -----------------------------------------------------------------------------
# HOW TO USE:  copy this file to `.env`, then fill in the values you need.
#     cp .env.example .env
# `.env` is git-ignored, so your keys never get committed. Anything left blank
# just uses the built-in default (shown in the comment). The real shell
# environment always wins over this file.
#
# Nothing here is required to try the app: `node server.js` works with all of
# it blank. Fill in only the sections for the features you want.
# =============================================================================


# ── Web server (node server.js) ──────────────────────────────────────────────
PORT=
# TLS (enables HTTPS). Leave blank for plain HTTP / behind a reverse proxy.
TLS_KEY=
TLS_CERT=
# Set to 1 to send Secure cookies when you terminate TLS at a proxy.
COOKIE_SECURE=


# ── MCP bridge (mcp-server.js — connects Claude / any LLM to your notes) ──────
# The running site the bridge talks to. Default: http://localhost:3000
NOTE_BASE_URL=
# Your account on that site. Create it in the browser first, or set
# NOTE_REGISTER=1 to auto-create it on first run.
NOTE_USER=
NOTE_PASS=
NOTE_REGISTER=


# ── Market data (trading tools) ──────────────────────────────────────────────
# Public DexScreener API — read-only, no key needed.
# Default: https://api.dexscreener.com  (override only to self-host / mock)
DEX_API_BASE=


# ── Sleeping-analyst watcher (strategy-watch.js) ─────────────────────────────
# Comma-separated symbols/pairs. Default: SOL/USDC
WATCH_SYMBOLS=
# Seconds between sweeps (min 15). Default: 60
WATCH_INTERVAL=
# QGPR forecast horizon in seconds, allowed 10-60. Blank = no forecast.
WATCH_HORIZON=


# ── Live execution — YOUR OWN endpoint (optional, off by default) ────────────
# The watcher NEVER trades directly and ships NO exchange keys. In live mode it
# POSTs each decision to YOUR https webhook, which holds your broker/exchange
# credentials and decides what to actually do. Exchange API keys belong on THAT
# endpoint — not in this file.
#
# 1 = enable dispatch. Still dry-run until WATCH_CONFIRM is set.
WATCH_LIVE=
# Your execution endpoint (must be https:// to arm live).
WATCH_WEBHOOK=
# Must equal exactly  I-UNDERSTAND  to actually send. Otherwise dry-run.
WATCH_CONFIRM=
# Per-trade notional cap in USD. Default: 25
WATCH_MAX_USD=
# Which actions may dispatch live. Default: buy,sell,reduce
WATCH_ACTIONS=
# Optional bearer token sent as `Authorization: Bearer <token>` to your webhook.
WATCH_SECRET=
